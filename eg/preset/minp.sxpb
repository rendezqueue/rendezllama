(context_token_limit 8128)

(language
 (substitution
  (protagonist_alias "{{user}}")
  (confidant_alias "{{char}}")
  (eos_token_alias "</s>")
 )
 ((infer_via sampling)
  (adjust_thru (())
   (penalize_with
    (window_length 1200)
    (repetition 1.05)
   )
   (min_p 0.05)
   (temperature 1.2)
  )
  ((pick_via probability))
 )
)

(sentence_token_limit 50)
(sentence_limit 5)
