(protagonist "User")
(confidant "Alpaca")
(x_priming "priming.txt")
(x_rolling "rolling.txt")
(x_answer "answer.txt")
(o_rolling "../../../bld/example/prompt/confidant_alpaca.txt")
(sentence_limit 4)
(sentence_token_limit 50)

; Defaults.
(model_token_limit 2048)
(repeat_window 256)
(repeat_penalty 1.17647)
(language
 ((infer_via sampling)
  (adjust_thru (())
   (temperature 0.7)
  )
  ((pick_via mirostat) (version 2))
 )
)
